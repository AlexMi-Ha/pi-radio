# Pi Radio deploy configuration.
#
# Copy this file to deploy/.env and fill in whatever you want to override,
# then run ./deploy/provision.sh as usual - it gets copied to the Pi and
# installed as /etc/default/pi-radio (used by the pi-radio systemd service).
#
# deploy/.env is gitignored (matched by the repo-wide ".env" rule) since it's
# machine-specific; deploy/.env.example stays checked in as the template.
#
# Lines left commented out are NOT sent to the Pi, so the deploy script's own
# defaults apply (e.g. PI_RADIO_PRESETS_PATH/PI_RADIO_SETTINGS_PATH/
# PI_RADIO_USE_HARDWARE, computed in remote-setup.sh - uncomment here only to
# override them). Everything else has in-code defaults - see README.md.

# Bluetooth
# Friendly name advertised to pairing devices (bluetoothctl system-alias).
# Leave unset to keep the Pi's hostname as the Bluetooth name.
#PI_RADIO_BLUETOOTH_NAME=Kitchen Radio

# Audio HAT (e.g. RaspiAudio HiFiBerry DAC)
# Set to the dtoverlay name for your HAT to disable onboard/HDMI audio and
# make the HAT's DAC the ALSA default (also installs deploy/asound.conf's
# softvol mixer as /etc/asound.conf, since these DACs have no hardware
# mixer). Leave unset if you have no audio HAT - onboard audio is left
# alone by default. See deploy/README.md for details.
#PI_RADIO_AUDIO_HAT=hifiberry-dac

# GPIO buttons / rotary encoder (BCM numbering)
#PI_RADIO_GPIO_POWER_BTN=17
#PI_RADIO_GPIO_MODE_BTN=27
#PI_RADIO_GPIO_ACTION_BTN=22
#PI_RADIO_GPIO_ENCODER_A=23
#PI_RADIO_GPIO_ENCODER_B=24
#PI_RADIO_GPIO_ENCODER_BTN=25

# I2C LCD display
#PI_RADIO_I2C_BUS=1
#PI_RADIO_I2C_LCD_ADDRESS=0x27

# Logging
#PI_RADIO_LOG_TO_FILE=false
#PI_RADIO_LOG_FILE_PATH=logs/pi-radio.log
#PI_RADIO_LOG_MAX_FILE_SIZE_BYTES=5242880
#PI_RADIO_LOG_MAX_FILES=3

# Storage paths (auto-set by remote-setup.sh to the persistent app-data
# mount - only override if you know what you're doing, see deploy/README.md)
#PI_RADIO_PRESETS_PATH=/var/lib/pi-radio/presets.json
#PI_RADIO_SETTINGS_PATH=/var/lib/pi-radio/settings.json
#PI_RADIO_USE_HARDWARE=true
